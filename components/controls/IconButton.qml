import qs.components.controls

// A round, icon-only button.
//
//   icon      Material Symbols name
//   size      one of Tokens.size (default regular): the button's diameter
//   iconSize  an icon token, if the size's own icon is not what you want
//   style     Button.Plain / Gray / Tinted / Filled
//   role      Button.Destructive for actions that delete or end something
Button {
    capsule: true
}
